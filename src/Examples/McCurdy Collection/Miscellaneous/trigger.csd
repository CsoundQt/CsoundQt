; Written by Iain McCurdy, 2010

; Modified for QuteCsound by René, February 2011
; Tested on Ubuntu 10.04 with csound-float 5.13.0 and QuteCsound svn rev 817


; Notes on modifications from original csd:


; my flags on Ubuntu: -dm0 -iadc -odac -+rtaudio=jack -b16 -B4096 -+rtmidi=null
<CsoundSynthesizer>
<CsOptions>

</CsOptions>
<CsInstruments>
sr     = 44100  ; Sample rate
ksmps  = 16     ; Number of audio samples in each control cycle
nchnls = 2      ; Number of channels (2=stereo)
0dbfs  = 1      ; Maximum amplitude will be 1


gisine ftgen 0, 0, 1024, 10, 1  ; A sine wave


instr 1  ; GUI and threshold crossing testing instrument

  ktrig metro 10
  if (ktrig == 1) then
    gkthreshold invalue "Threshold"
    gksignal    invalue "TriggerSignal"
    gkmode      invalue "Mode"
  endif

  ain inch 1
  afollow follow2 ain, 0.01, 0.01  ; Create a amplitude following unipolar signal
  ; Downsample to create a k-rate version of the amplitude following signal
  kfollow downsamp afollow
  ; Output a momentary 1 if 'gksignal' crosses 'gkthreshold' in the direction(s) according
  ; TO 'gkmode'
  kbang trigger gksignal, gkthreshold, gkmode
  ; Opcode   ktrigger, kmintime, kmaxnum, kinsnum, kwhen, kdur
  schedkwhen kbang, 0, 0, 2, 0, 1  ; Instruct instr 2 to play a note whenever 'kbang' is 1
endin

instr 2
  ; Define the pitch of the note according to whether this note was generated by an upward
  ; or a downward crossing
  icps = (i(gksignal)>i(gkthreshold)?500:300)
  aenv expon 0.5, p3, 0.0001      ; Percussive envelope
  asig oscili aenv, icps, gisine  ; Audio oscillator
  outs asig, asig                 ; Send audio to outputs
endin
</CsInstruments>
<CsScore>
; Threshold crossing testing instrument plays for 1 hour (and keeps realtime performance
; going)
i 1 0 3600
</CsScore>
</CsoundSynthesizer>
